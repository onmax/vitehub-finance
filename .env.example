# Required
BETTER_AUTH_SECRET=        # openssl rand -hex 32
JOXI_ENCRYPTION_KEY=       # openssl rand -hex 32 — encrypts bank sessions and exchange keys

# Keep it private: only these emails (and invited people) can sign up. Empty = anyone.
JOXI_ALLOWED_EMAILS=

# Enable Banking (enablebanking.com) — EU banks over PSD2. Restricted apps are free for your own accounts.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY= # the app's PKCS#8 PEM, newlines as \n

# Optional
COINGECKO_API_KEY=
RESEND_API_KEY=            # set at build time to send email (invites, magic links, reminders)
JOXI_EMAIL_FROM="Joxi <joxi@example.com>"

# Build-time host choice: cloudflare (default) or node
JOXI_HOST=
JOXI_DOMAIN=               # e.g. finance.example.com (Cloudflare custom domain)
CLOUDFLARE_D1_DATABASE_ID=
