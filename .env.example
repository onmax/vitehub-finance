# Required
BETTER_AUTH_SECRET=        # openssl rand -hex 32
FINANCE_ENCRYPTION_KEY=       # openssl rand -hex 32 — encrypts bank sessions and exchange keys

# Keep it private: only these emails (and invited people) can sign up. Empty = anyone. Ignored when FINANCE_DEMO=1.
FINANCE_ALLOWED_EMAILS=

# Enable Banking (enablebanking.com) — EU banks over PSD2. Restricted apps are free for your own accounts.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY= # the app's PKCS#8 PEM, newlines as \n

# Optional
COINGECKO_API_KEY=
TYPESAFE_API_KEY=          # typesafe.ai: AI categories for what the rules miss. Sends descriptions, never IBANs or names
AI_GATEWAY_API_KEY=         # or reach Jev through Vercel AI Gateway, when TYPESAFE_API_KEY is empty
CLOUDFLARE_AI_GATEWAY_ID=   # or through a Cloudflare AI Gateway, with TYPESAFE_API_KEY, CLOUDFLARE_ACCOUNT_ID, and CLOUDFLARE_AI_GATEWAY_TOKEN
RESEND_API_KEY=            # set at build time to send email (invites, magic links, reminders)
FINANCE_EMAIL_FROM="ViteHub Finance <finance@example.com>"

# Optional: the contact address on /privacy
FINANCE_CONTACT_EMAIL=

# Build-time host choice: cloudflare (default) or node
FINANCE_HOST=
FINANCE_DEMO=                 # 1 builds the public demo: a fictional household visitors enter without signing up, read-only, reset nightly
FINANCE_DOMAIN=               # e.g. finance.example.com (Cloudflare custom domain)
CLOUDFLARE_D1_DATABASE_ID=
