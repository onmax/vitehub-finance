{
  "name": "vitehub-finance",
  "private": true,
  "type": "module",
  "description": "Household finance on ViteHub: bank and crypto sync, shared accounts, forecasts, and an MCP server.",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host 127.0.0.1",
    "preview": "node .output/server/index.mjs",
    "postinstall": "vitehub types prepare && nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "mkdir -p .vitehub/data/database && drizzle-kit migrate --config .vitehub/database/drizzle.config.ts",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json",
    "deploy": "pnpm build && pnpm db:migrate:remote && wrangler deploy --config .output/server/wrangler.json",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.10",
    "@better-auth/oauth-provider": "1.7.10",
    "@better-auth/passkey": "1.7.10",
    "@comark/vue": "0.8.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/simple-icons": "^1.2.60",
    "@internationalized/date": "^3.12.4",
    "@nuxt/ui": "4.11.0",
    "@valibot/to-json-schema": "^1.8.0",
    "@vitehub-finance/banking": "workspace:*",
    "@vitehub-finance/brokers": "workspace:*",
    "@vitehub-finance/crypto": "workspace:*",
    "@vitehub-finance/payments": "workspace:*",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "advocaat": "0.0.6",
    "better-auth": "1.7.10",
    "comark": "0.8.1",
    "comark-content": "0.4.3",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "drizzle-orm": "0.45.3",
    "evlog": "2.33.1",
    "h3": "2.0.1",
    "nuxt": "npm:nuxt-nightly@5.0.0-29766097.1e475df9",
    "ofetch": "2.0.0-alpha.3",
    "okmcp": "file:vendor/okmcp-0.2.1-main.2239349.tgz",
    "tailwindcss": "4.3.3",
    "valibot": "^1.4.2",
    "vite-hub": "https://pkg.pr.new/vite-hub/vitehub/vite-hub@80a25d0",
    "vue": "3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "5.2.0",
    "comark-ui": "0.7.2",
    "@comark/html": "0.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260825.1",
    "@iconify-json/ph": "^1.2.2",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^25.9.2",
    "drizzle-kit": "^0.31.10",
    "nitro": "3.0.260610-beta",
    "typescript": "^6.0.3",
    "vite": "8.2.2",
    "vue-tsc": "^3.3.9",
    "wrangler": "4.148.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@11.28.6",
  "license": "MIT"
}
