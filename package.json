{
  "name": "vitehub-finance",
  "private": true,
  "type": "module",
  "description": "Household finance on ViteHub: bank and crypto sync, shared accounts, forecasts, and an MCP server.",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host 127.0.0.1",
    "preview": "node .output/server/index.mjs",
    "postinstall": "vitehub types prepare && nuxt prepare",
    "db:generate": "vitehub database generate",
    "db:migrate": "FINANCE_HOST=node vitehub database migrate",
    "deploy": "pnpm build && nitro deploy --prebuilt",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.15",
    "@better-auth/oauth-provider": "1.7.15",
