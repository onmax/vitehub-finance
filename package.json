    "@fontsource-variable/geist-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.149",
    "@iconify-json/simple-icons": "^1.2.101",
    "@internationalized/date": "^3.12.4",
    "@nuxt/ui": "4.12.0",
    "@valibot/to-json-schema": "^1.8.0",
    "@vite-hub/mcp": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/mcp@fb731b2f91a8c608f349adf478c3e419459264b7",
    "@vitehub-finance/banking": "workspace:*",
    "@vitehub-finance/brokers": "workspace:*",
